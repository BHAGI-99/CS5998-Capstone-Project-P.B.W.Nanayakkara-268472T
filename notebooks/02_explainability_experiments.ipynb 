        "print(f\"\\nDeletion: pressure AUC minus IG AUC = {d_del.mean():+.3f} (SD {d_del.std():.3f}); IG better in {(d_del>0).sum()} of {len(df)} seeds\")\n",
        "print(f\"Insertion: IG AUC minus pressure AUC = {d_ins.mean():+.3f} (SD {d_ins.std():.3f}); IG better in {(d_ins>0).sum()} of {len(df)} seeds\")"
